# MuxCore Module — Environment Variables
# Copy to .env and adjust for your environment.

# Core connection
# MUXCORE_GRPC_ADDR=localhost:9090
# MUXCORE_INSECURE_DISABLE_TLS=true

# Module identity
# MUXCORE_MODULE_ID=backup-local

# Backup storage
# BACKUP_DIR=backups
# BACKUP_SOURCE_DIRS=/var/lib/muxcore/data,/var/lib/muxcore/config
