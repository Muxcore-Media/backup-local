# MuxCore Module — Environment Variables
# Copy to .env and adjust for your environment.

# Core connection
# MUXCORE_GRPC_ADDR=localhost:9090
# MUXCORE_INSECURE_DISABLE_TLS=true

# Module identity
# MUXCORE_MODULE_ID=backup-local

# Backup storage
# BACKUP_DIR=backups
# BACKUP_SOURCE_DIRS=/var/lib/muxcore/data,/var/lib/muxcore/config
# BACKUP_ALLOWED_ROOTS=/var/lib/muxcore/data,/var/lib/muxcore/restore
# BACKUP_EXCLUDE=.incomplete,*.parts,*.part,*.!qb,*.tmp

# Retention (also available as admin settings max_backups / max_age_days)
# BACKUP_MAX_BACKUPS=0
# BACKUP_MAX_AGE_DAYS=0

# Optional AES-256 archive encryption (64 hex chars = 32 bytes)
# BACKUP_ENCRYPT_KEY=

# Scheduled backups (5-field cron; also schedule_cron setting)
# BACKUP_SCHEDULE=0 3 * * *

# Listen addresses
# BACKUP_HTTP_ADDR=:9303
