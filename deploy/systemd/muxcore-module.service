[Unit]
Description=MuxCore Module - backup-local
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=muxcore
Group=muxcore
ExecStart=/usr/local/bin/backup-local \
  --muxcore-mesh-addr localhost:9090 \
  --muxcore-module-id backup-local
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

; Security hardening
CapabilityBoundingSet=
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/backup-local

[Install]
WantedBy=multi-user.target
